    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "socket.io-client": "^4.7.5",
    "vite-plugin-pwa": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
