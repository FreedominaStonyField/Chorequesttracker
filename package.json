    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "drizzle-kit": "^0.26.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^50.6.1",
    "eslint-plugin-sonarjs": "^1.0.4",
    "supertest": "^7.1.1",
    "tsx": "^4.19.2",
    "vitest": "^3.2.4"
