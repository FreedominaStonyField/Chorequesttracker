    "drizzle-orm": "^0.36.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nanoid": "^5.1.6",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "better-sqlite3": "^11.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
