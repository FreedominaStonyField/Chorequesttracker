#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_BIN="$SCRIPT_DIR/../ts-node-dev/lib/bin.js"

if [[ ! -f "$REAL_BIN" ]]; then
  echo "Unable to locate ts-node-dev executable at $REAL_BIN" >&2
  exit 1
fi

args=()
while (($#)); do
  case "$1" in
    --esm)
      args+=("--loader" "ts-node/esm")
      ;;
    *)
      args+=("$1")
      ;;
  esac
  shift
done

exec node "$REAL_BIN" "${args[@]}"
